# rag_pipeline/.env.example
# Copy this file to .env and fill in only the provider you use.

# Option A: GCP Vertex AI (recommended for this project)
# 1) Enable Vertex AI API in this GCP project.
# 2) Authenticate with either:
#    - gcloud auth application-default login
#    - or GOOGLE_APPLICATION_CREDENTIALS pointing to a service-account JSON file.
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# Optional when using a service account instead of gcloud ADC.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Option B: Google AI Studio API key
# GEMINI_API_KEY=AIzaSy...
# GOOGLE_API_KEY=AIzaSy...

# Option C: Groq API key
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# LLM_MODEL overrides provider-specific model settings when set.
# LLM_MODEL=gemini-2.5-flash
