# Copy this file to `.env` and fill only the values you use.

# Google AI Studio API key. Recommended for demo chatbot/image features.
GEMINI_API_KEY=

# Optional aliases supported by the backend.
GOOGLE_API_KEY=
GROQ_API_KEY=

# Optional Vertex AI mode. Use a real project id only when using Vertex credentials.
GCP_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1

# Optional model overrides.
LLM_MODEL=gemini-2.5-flash
IMAGE_MODEL=gemini-2.5-flash-image
